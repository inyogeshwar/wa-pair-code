# ─────────────────────────────────────────────────────────────
# WA Pair Code — environment configuration
# Copy to `.env` for local development. On a host, set these as
# environment variables instead. No secrets are required.
# ─────────────────────────────────────────────────────────────

# HTTP port (hosts usually inject PORT automatically)
PORT=3000

# Name shown in the page header
BOT_NAME=WA Pair Code

# Turn either login method off without changing code
ALLOW_PAIRING=true
ALLOW_QR=true

# Max simultaneous WhatsApp sockets. Each one costs ~60-120 MB RAM.
# 2 is safe on a 512 MB free instance.
MAX_SESSIONS=2

# Hard cap on sessions kept on disk. Linked sessions drop their socket and
# stay downloadable for PAIRED_KEEP_MS, so they do not use a socket slot.
MAX_STORED_SESSIONS=40

# How long a session waits for the user to finish linking (ms)
SESSION_TTL_MS=300000

# How long a linked session stays downloadable (ms)
PAIRED_KEEP_MS=600000

# How long to wait for WhatsApp's first ready signal (ms)
READY_TIMEOUT_MS=30000

# Per-IP request budget
RATE_LIMIT=5
RATE_WINDOW_MS=600000

# Per-number request budget (WhatsApp throttles these too)
NUMBER_LIMIT=2
NUMBER_WINDOW_MS=600000

# Set to true when running behind Render/Railway/Fly/a reverse proxy
TRUST_PROXY=true

# info | debug | warn | error — Baileys' own logs are silenced separately
LOG_LEVEL=info
